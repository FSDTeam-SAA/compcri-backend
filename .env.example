OPENAI_REASONING_EFFORT=none
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
OPENAI_VOICE_MAX_FILE_MB=10
AI_PROVIDER_TIMEOUT_MS=30000
AI_DAILY_QUOTA=50
